# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Databases — the whole dir: nothing tracked lives here, and the WAL/SHM
# sidecars carry the same personal data as the .db files (review F19).
# Root-anchored: the unanchored form shadows android/core/data/ (the Room/
# sync module) — new files there would be silently ignored and git add of
# its tracked files refused. Same rationale for the other /-anchored dirs.
/data/

# Runtime
server.log
.server.pid
*.log
*.log.1

# User-specific queries (contains personal medical data)
src/modules/user_queries.py

# Fitted sleep-need constants (regressed from private health data — the
# numbers themselves are personal; sleep_params.example.py documents the shape)
src/modules/sleep_params.py

# Personal medical retrospectives — belong in the private health repo
/retrospectives/

# IDE
.vscode/
.idea/

# Planning docs
/plans/

# Claude Code (root file only — android/CLAUDE.md is tracked)
/CLAUDE.md
.claude/
# Agent skills mirror (machine-specific: carries emulator host addresses)
.agents/

# OS
.DS_Store
bin/backup-databases.sh
bin/backup-gitignored.sh
bin/quick-deploy.sh
bin/weight_trend_chart.py
bin/git-commit-push.sh
