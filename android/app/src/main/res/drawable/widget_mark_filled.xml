<?xml version="1.0" encoding="utf-8"?>
<!--
    The filled mark: "it happened, and it counted."

    Geometry ported from InkJudgment.SETTLED — a circle at the full radius of
    its box, at viewport 12. It is the 9dp judgment glyph; until 2026-11-10 it
    was also the 8dp tally dot, before the tally became strokes
    (widget_tally_post, widget_tally_gate).

    The authored fill colour is IRRELEVANT: every use site draws this through
    ColorFilter.tint(ColorProvider), which is how the one-ink rule survives into
    a surface that cannot read LogbookTheme. Black is simply the neutral author.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="12dp"
    android:height="12dp"
    android:viewportWidth="12"
    android:viewportHeight="12">
    <path
        android:fillColor="#000000"
        android:pathData="M6,6 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />
</vector>
