<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Heart-rate capture. BLUETOOTH_SCAN/CONNECT are declared by :core:ble and
         merge in from there, with the code that needs them.

         The service type is connectedDevice and nothing else: the strap is the
         connected device, and the uploads it produces ride WorkManager and the
         ordinary sync schedulers rather than the service — so dataSync would be
         claiming a capability this app does not use, on a type whose quotas
         tightened in Android 15. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Requested at first pairing, and a denial never blocks capture: the
         service still runs, its notification is simply not shown. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- PARTIAL_WAKE_LOCK for the length of a capture. No keepScreenOn anywhere:
         this shows a number, not a live tachogram. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- usesCleartextTraffic: dev server is plain HTTP inside the tailnet
         (see plan.md "Transport"); revisit when pointing at tailscale serve. -->
    <application
        android:name=".WellnessApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wellness"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Started only from a foreground user action (the strap section or the
             Start Workout sheet), with BLUETOOTH_CONNECT already granted.
             exported=false: nothing outside this app has any business starting a
             capture, and the only intents it accepts come from its own UI. -->
        <service
            android:name=".hr.HrCaptureService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Exports and debug-log dumps reach a share sheet through here.
             exported=false with grantUriPermissions=true is the whole contract:
             no other app may address the provider, and the only access anyone
             gets is the per-URI read grant that travels with the share Intent
             and expires with it. Paths are restricted in file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
